# Optional override. By default Moneta selects the database in the backend directory.
# DATABASE_URL=sqlite:///./moneta.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional financial coach. Keep the real key in .env or your hosting secret store.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
